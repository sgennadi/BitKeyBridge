    <RootNamespace>UniversalDiagnostics</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalDiagnostics.Embedded</AssemblyName>
  </PropertyGroup>
</Project>
