{
  "SysvolScriptsRoot": "C:\\Windows\\SYSVOL\\domain\\scripts",
  "OutputSubdirectory": "BL",
  "StaleSuccessHours": 36,
  "ReplicationStaleHours": 24,
  "BlockExportOnReplicationErrors": false,
  "AllowPartialExport": false,
  "AllowEmptyExport": false,
  "FailIfOutputAclIsBroad": false,
  "BlockSuspiciousRowDrop": true,
  "MinimumRowsForDropGuard": 10,
  "CriticalRowRatio": 0.5,
  "WarningRowRatio": 0.8,
  "BlockPublishOnScopeChange": true,
  "TestBitLockerCountsOnReadOnlyDcs": false,
  "MaxLogSizeMb": 10,
  "DefaultScopes": [
    {
      "Name": "Windows Clients",
      "SearchBase": "OU=Windows Clients,OU=Computers,DC=example,DC=com"
    }
  ],
  "HealthEndpointEnabled": true,
  "HealthEndpointPort": 8750,
  "ServiceIntervalMinutes": 60,
  "ServiceRunExportOnStart": true,
  "UpdateRepository": "sgennadi/BitKeyBridge",
  "CheckForUpdatesOnStart": true,
  "AllowPrereleaseUpdates": false,
  "RemoteApiEnabled": false,
  "RemoteApiPort": 8751,
  "RemoteApiAllowManagement": false,
  "RemoteApiCertificateThumbprint": "",
  "RemoteApiTokenSha256": "",
  "RequireRecoveryAccessReference": false,
  "SuggestRotationAfterCloudKeyRetrieval": true
}
